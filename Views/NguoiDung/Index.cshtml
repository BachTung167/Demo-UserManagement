@model IEnumerable<UserManagement.Models.NguoiDung>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CenterPlus - Quản lý nhân sự</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary: #4facfe;
            --secondary: #00f2fe;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .header-panel {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 3rem 1rem;
            text-align: center;
            border-radius: 0 0 2.5rem 2.5rem;
            margin-bottom: -2.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .main-card {
            background: white;
            border-radius: 1.2rem;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            margin: 0 auto 2rem auto;
            position: relative;
            z-index: 1;
            width: 95%;
        }

        .table-responsive {
            border-radius: 0.8rem;
            overflow-x: auto;
            padding: 5px;
        }

        .table {
            min-width: 1100px;
        }

        /* Ép ngày sinh luôn nằm trên 1 dòng */
        .col-birthday {
            white-space: nowrap !important;
            width: 140px;
        }

        .id-badge {
            background-color: #f1f3f5;
            color: #6c757d;
            padding: 0.3rem 0.7rem;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .action-column {
            width: 200px !important;
            text-align: center;
        }

        .action-group {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn-action {
            border-radius: 0.6rem;
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        footer {
            margin-top: auto;
            padding: 2.5rem 0;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header-panel">
        <div class="container">
            <h1 class="fw-bold m-0 display-6 text-uppercase">UserManagement</h1>
            <p class="opacity-75 lead small">Hệ thống Quản lý CenterPlus &bull; 2026</p>
        </div>
    </div>

    <div class="container-fluid mt-5 flex-grow-1">
        <div class="main-card">
            <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                <h4 class="fw-bold m-0 text-dark">
                    <i class="bi bi-people-fill me-2 text-primary"></i>Thành viên hệ thống
                </h4>
                <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold">
                    <i class="bi bi-plus-lg"></i> Thêm mới
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase fw-bold text-secondary">
                            <th class="text-center" style="width: 80px;">STT</th>
                            <th>Họ tên</th>
                            <th class="col-birthday">Ngày sinh</th>
                            <th>Email</th>
                            <th>Điện thoại</th>
                            <th>Địa chỉ</th>
                            <th class="action-column">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var item in Model.OrderBy(x => x.Ma))
                        {
                            <tr>
                                <td class="text-center"><span class="id-badge">@i</span></td>
                                <td class="fw-bold text-dark text-nowrap">@item.HoTen</td>
                                <td class="col-birthday text-secondary small">@item.NgaySinh?.ToString("dd/MM/yyyy")</td>
                                <td class="small">@item.Email</td>
                                <td class="small">@item.DienThoai</td>
                                <td class="text-muted small">@item.DiaChi</td>
                                <td class="action-column">
                                    <div class="action-group">
                                        <a asp-action="Edit" asp-route-id="@item.Ma" class="btn btn-outline-primary btn-action">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a href="javascript:void(0)"
                                           onclick="confirmDelete('@Url.Action("Delete", "NguoiDung", new { id = item.Ma })', '@item.HoTen')"
                                           class="btn btn-outline-danger btn-action">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <hr style="width: 100px; margin: 0 auto 1.5rem auto; opacity: 0.2;">
            <p class="mb-1 text-secondary small">
                &copy; 2026 - Designed with ❤️ by <strong>TungBB</strong> [cite: 2025-10-26]
            </p>
            <p class="small text-muted mb-0">UserManagement System v1</p>
        </div>
    </footer>

    <script>
        function confirmDelete(deleteUrl, userName) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Bạn có chắc chắn muốn xóa thành viên " + userName + " không? Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đúng, xóa ngay!',
                cancelButtonText: 'Hủy bỏ',
                borderRadius: '1.2rem'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = deleteUrl;
                }
            })
        }
    </script>
</body>
</html>