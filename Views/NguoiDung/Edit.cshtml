@model UserManagement.Models.NguoiDung

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cập nhật thành viên - CenterPlus</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            --btn-update: #0984e3;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        .header-panel {
            background: var(--primary-gradient);
            color: #2d3436;
            padding: 3.5rem 1rem;
            text-align: center;
            border-radius: 0 0 40px 40px;
            margin-bottom: -3.5rem;
        }

        .form-card {
            background: white;
            border-radius: 1.5rem;
            padding: 2.5rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 600px;
            margin: 0 auto 3rem auto;
            position: relative;
            z-index: 1;
        }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border-radius: 0.75rem;
            padding: 12px;
            border: 1px solid #e9ecef;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #0984e3;
                box-shadow: 0 0 0 0.25rem rgba(9, 132, 227, 0.15);
            }

        .text-danger {
            font-size: 0.85rem;
            font-weight: 500;
            margin-top: 0.25rem;
            display: block;
        }

        .btn-update {
            background: var(--btn-update);
            color: white;
            border-radius: 30px;
            padding: 12px 35px;
            border: none;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-update:hover {
                background: #74b9ff;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(9, 132, 227, 0.25);
                color: white;
            }
    </style>
</head>
<body>
    <div class="header-panel shadow-sm">
        <div class="container">
            <h2 class="fw-bold text-uppercase m-0"><i class="bi bi-pencil-square"></i> Cập nhật thông tin</h2>
            <p class="mt-2 mb-0">Chỉnh sửa hồ sơ: <span class="fw-bold">@Model.HoTen</span></p>
        </div>
    </div>

    <div class="container">
        <div class="form-card">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Ma" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên..." />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Điện thoại</label>
                        <input asp-for="DienThoai" class="form-control" placeholder="09xxxxxxxx" />
                        <span asp-validation-for="DienThoai" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="example@centerplus.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Địa chỉ</label>
                    <input asp-for="DiaChi" class="form-control" placeholder="Số nhà..., tên đường..., quận/huyện..." />
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="text-decoration-none text-muted fw-medium">Hủy bỏ</a>
                    <button type="submit" class="btn btn-update shadow-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <hr style="width: 100px; margin: 0 auto 1.5rem auto; opacity: 0.2;">
            <p class="mb-1 text-secondary small">
                &copy; 2026 - Designed with ❤️ by <strong>TungBB</strong> [cite: 2025-10-26]
            </p>
            <p class="small text-muted mb-0">UserManagement System v1</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>